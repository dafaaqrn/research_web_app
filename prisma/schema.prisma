generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Capture {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  photo      String?  @db.Text
  userAgent  String?

  @@map("captures")
}